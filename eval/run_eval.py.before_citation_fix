import json
import re
import sys
import time

import requests

API_URL = "http://localhost:8000/investigate"
QUESTIONS_PATH = "eval/questions.json"
RESULTS_PATH = "eval/results.json"


def normalize(text: str) -> str:
    text = text.lower()
    text = re.sub(r"[^\w\s]", " ", text)
    return re.sub(r"\s+", " ", text).strip()


def answer_correct(answer: str, gold: str) -> bool:
    return normalize(gold) in normalize(answer)


def citation_accuracy(answer: str, sources: list[dict], gold_titles: list[str]) -> float:
    """პასუხში მითითებული [N] წყაროებიდან რა წილი შეიცავს სწორ supporting title-ს."""
    cited = {int(n) for n in re.findall(r"\[(\d+)\]", answer)}
    if not cited:
        return 0.0
    gold_norm = {normalize(t) for t in gold_titles}
    by_index = {s["index"]: s for s in sources}
    correct = 0
    for n in cited:
        src = by_index.get(n)
        if src and normalize(src.get("title") or "") in gold_norm:
            correct += 1
    return correct / len(cited)


def recall_at_k(sources: list[dict], gold_titles: list[str], k: int) -> float:
    gold_norm = {normalize(t) for t in gold_titles}
    retrieved = [normalize(s.get("title") or "") for s in sources[:k]]
    hits = sum(1 for g in gold_norm if g in retrieved)
    return hits / len(gold_norm) if gold_norm else 0.0


def reciprocal_rank(sources: list[dict], gold_titles: list[str]) -> float:
    gold_norm = {normalize(t) for t in gold_titles}
    for rank, s in enumerate(sources, 1):
        if normalize(s.get("title") or "") in gold_norm:
            return 1.0 / rank
    return 0.0



def main():
    import os
    import shutil

    with open(QUESTIONS_PATH, encoding="utf-8") as f:
        questions = json.load(f)

    rows = []
    results_file = str(RESULTS_PATH)
    backup_results = results_file + ".before_retry"

    if os.path.exists(results_file):
        shutil.copy2(results_file, backup_results)
        print(f"Previous results backed up to: {backup_results}")

    os.makedirs(os.path.dirname(results_file) or ".", exist_ok=True)

    def save_results():
        with open(results_file, "w", encoding="utf-8") as f:
            json.dump(rows, f, ensure_ascii=False, indent=2)

    session = requests.Session()
    max_attempts = 3
    retryable_statuses = {408, 409, 429, 500, 502, 503, 504}
    question_delay = 5

    print(f"Starting evaluation: {len(questions)} questions", flush=True)

    for i, q in enumerate(questions, 1):
        question = q["question"]
        print(
            f"\n[{i}/{len(questions)}] {question[:70]}...",
            flush=True,
        )

        started = time.time()
        data = None
        last_error = None
        status_code = None
        attempts_used = 0

        for attempt in range(1, max_attempts + 1):
            attempts_used = attempt
            response = None

            try:
                response = session.post(
                    API_URL,
                    json={"query": question},
                    timeout=(10, 150),
                )
                status_code = response.status_code

                if (
                    status_code in retryable_statuses
                    and attempt < max_attempts
                ):
                    retry_after = response.headers.get("Retry-After")
                    try:
                        delay = max(
                            float(retry_after),
                            5 * (2 ** (attempt - 1)),
                        ) if retry_after else 5 * (2 ** (attempt - 1))
                    except (ValueError, TypeError):
                        delay = 5 * (2 ** (attempt - 1))

                    delay = min(delay, 60)
                    print(
                        f"Temporary HTTP {status_code}; "
                        f"retry {attempt + 1}/{max_attempts} "
                        f"in {delay:.0f}s",
                        flush=True,
                    )
                    time.sleep(delay)
                    continue

                response.raise_for_status()
                data = response.json()

                if not isinstance(data, dict):
                    raise ValueError("API response was not a JSON object")

                break

            except (requests.RequestException, ValueError) as exc:
                last_error = exc
                status_code = getattr(
                    getattr(exc, "response", None),
                    "status_code",
                    status_code,
                )

                retryable = (
                    status_code is None
                    or status_code in retryable_statuses
                )

                if retryable and attempt < max_attempts:
                    retry_after = None
                    if response is not None:
                        retry_after = response.headers.get("Retry-After")

                    try:
                        delay = max(
                            float(retry_after),
                            5 * (2 ** (attempt - 1)),
                        ) if retry_after else 5 * (2 ** (attempt - 1))
                    except (ValueError, TypeError):
                        delay = 5 * (2 ** (attempt - 1))

                    delay = min(delay, 60)
                    print(
                        f"Request failed ({type(exc).__name__}); "
                        f"retry {attempt + 1}/{max_attempts} "
                        f"in {delay:.0f}s",
                        flush=True,
                    )
                    time.sleep(delay)
                    continue

                break

        elapsed = round(time.time() - started, 2)

        if data is None:
            error_text = str(last_error or "Request failed without a response")
            print(
                f"FAILED after {attempts_used} attempt(s), "
                f"HTTP={status_code}, time={elapsed}s: "
                f"{error_text[:300]}",
                flush=True,
            )

            rows.append({
                "id": q.get("id", f"question-{i}"),
                "type": q.get("type"),
                "level": q.get("level"),
                "question": question,
                "error": error_text[:1000],
                "http_status": status_code,
                "attempts": attempts_used,
                "elapsed_seconds": elapsed,
            })
        else:
            sources = data.get("sources", []) or []
            answer = data.get("answer", "")
            gold_titles = q["supporting_titles"]

            row = {
                "id": q["id"],
                "type": q["type"],
                "level": q["level"],
                "question": question,
                "gold_answer": q["answer"],
                "gold_titles": gold_titles,
                "system_answer": answer,
                "retrieved_titles": [
                    source.get("title") for source in sources
                ],
                "answer_correct": answer_correct(
                    answer, q["answer"]
                ),
                "recall_at_3": recall_at_k(
                    sources, gold_titles, 3
                ),
                "recall_at_6": recall_at_k(
                    sources, gold_titles, 6
                ),
                "mrr": reciprocal_rank(
                    sources, gold_titles
                ),
                "citation_accuracy": citation_accuracy(
                    answer, sources, gold_titles
                ),
                "attempts": attempts_used,
                "elapsed_seconds": elapsed,
            }
            rows.append(row)

            print(
                f"SUCCESS | HTTP 200 | {elapsed}s | "
                f"sources={len(sources)}",
                flush=True,
            )

        # Save progress after every question, including failures.
        save_results()

        if i < len(questions):
            time.sleep(question_delay)

    ok = [row for row in rows if "error" not in row]
    failed = [row for row in rows if "error" in row]
    n = len(ok)

    print("\n=== Evaluation Results ===")
    print(f"Total questions: {len(questions)}")
    print(f"Successfully processed: {n}/{len(questions)}")
    print(f"Failed questions: {len(failed)}")

    if n == 0:
        print("No questions completed successfully.")
        print(f"Results file: {results_file}")
        sys.exit(1)

    print(
        f"Answer Correctness: "
        f"{sum(row['answer_correct'] for row in ok) / n:.2%}"
    )
    print(
        f"Recall@3: "
        f"{sum(row['recall_at_3'] for row in ok) / n:.2%}"
    )
    print(
        f"Recall@6: "
        f"{sum(row['recall_at_6'] for row in ok) / n:.2%}"
    )
    print(
        f"MRR: "
        f"{sum(row['mrr'] for row in ok) / n:.3f}"
    )
    print(
        f"Citation Accuracy: "
        f"{sum(row['citation_accuracy'] for row in ok) / n:.2%}"
    )

    if failed:
        print("\nFailed question IDs:")
        for row in failed:
            print(
                f"- {row['id']}: HTTP {row.get('http_status')}; "
                f"{row.get('error', '')[:180]}"
            )

    print(f"\nDetailed results: {results_file}")
    if os.path.exists(backup_results):
        print(f"Previous results backup: {backup_results}")


if __name__ == "__main__":
    main()
